### Register

< {%
    client.global.clear("testEmail");
    client.global.clear("accessToken");
    client.global.clear("customerId");
    client.global.clear("cartId");
    client.global.clear("orderId");
    client.global.clear("checkoutUrl");

    const email = "e2e-" + Date.now() + "@example.com";

    client.global.set("testEmail", email);
%}

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

> {%
    const registrationSucceeded = response.status === 200;
    client.test("registration succeeds", function () {
        client.assert(registrationSucceeded, "Expected 200 from registration");
    });

    if (!registrationSucceeded) {
        client.global.clear("testEmail");
    }
%}

###

### Login

< {% client.global.clear("accessToken"); %}

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

> {%
    const loginSucceeded = response.status === 200 && response.body.accessToken != null;

    client.test("login succeeds", function () {
        client.assert(response.status === 200, "Expected 200 from login");
        client.assert(response.body.accessToken != null, "Access token must be present");
    });

    if (loginSucceeded) {
        client.global.set("accessToken", response.body.accessToken);
    } else {
        client.global.clear("accessToken");
    }
%}

###

### Customer provisioning is asynchronous.
### Repeat until the registered email appears.

GET {{baseUrl}}/customers?page=0&size=100
Authorization: Bearer {{accessToken}}

> {%
    client.global.clear("customerId");

    const responseSucceeded = response.status === 200 && Array.isArray(response.body.content);
    client.test("customer list is available", function () {
        client.assert(responseSucceeded, "Expected a customer list response");
    });

    if (!responseSucceeded) {
        client.log("Customer provisioning lookup failed; run this request again.");
    } else {
        const customer = response.body.content.find(
            item => item.email === client.global.get("testEmail")
        );

        if (customer != null && customer.customerId != null) {
            client.global.set("customerId", customer.customerId);
            client.log("Customer provisioned: " + customer.customerId);
        } else {
            client.log("Customer not provisioned yet; run this request again.");
        }
    }
%}

