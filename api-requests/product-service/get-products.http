### Get product by id
GET {{productBaseUrl}}/products/{{productId}}


### Get inactive product
GET {{productBaseUrl}}/products/{{inactiveProductId}}


### Get products
GET {{productBaseUrl}}/products?page=0&size=10


### Get second page
GET {{productBaseUrl}}/products?page=1&size=10


### Product not found - expect 404
GET {{productBaseUrl}}/products/99999999-9999-9999-9999-999999999999


### Product Bulk Lookup - with duplicate
POST {{productBaseUrl}}/products/bulk-lookup
Content-Type: application/json

{
  "requestedProductIds": [
    "d0000000-0000-0000-0000-000000000013",
    "d0000000-0000-0000-0000-000000000014",
    "d0000000-0000-0000-0000-000000000015",
    "d0000000-0000-0000-0000-000000000015"
  ]
}


### Product Bulk Lookup - expect 404
POST {{productBaseUrl}}/products/bulk-lookup
Content-Type: application/json

{
  "requestedProductIds": [
    "d0000000-0000-0000-0000-000000000013",
    "99999999-9999-9999-9999-999999999999",
    "d0000000-0000-0000-0000-000000000015",
    "99999999-9999-9999-9999-888888888888"
  ]
}


