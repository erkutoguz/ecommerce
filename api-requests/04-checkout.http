### Step 4 - Start checkout
# Requires: cartId from step 3 and Product A in the cart.
# Produces: orderId from the real OrderResponse.orderId field.

< {% client.global.clear("orderId"); %}

POST {{baseUrl}}/carts/{{cartId}}/checkout
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "currency": "TRY"
}

> {%
    client.test("checkout creates an order", function () {
        client.assert(response.status === 201, "Expected 201 from checkout");
        client.assert(response.body.orderId != null, "Order id must be present");
    });
    if (response.status === 201 && response.body.orderId != null) {
        client.global.set("orderId", response.body.orderId);
    } else {
        client.global.clear("orderId");
    }
%}
