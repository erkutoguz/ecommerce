### Step 3 - Create/get an active cart and add Product A
# Requires: successful Auth.http bootstrap and the static productAId environment value.
# Produces: cartId, which step 4 uses for checkout.

< {% client.global.clear("cartId"); %}

GET {{baseUrl}}/carts/current
Authorization: Bearer {{accessToken}}

> {%
    client.test("active cart is returned", function () {
        client.assert(response.status === 200, "Expected 200 from current cart");
        client.assert(response.body.id != null, "Cart id must be present");
    });
    if (response.status === 200 && response.body.id != null) {
        client.global.set("cartId", response.body.id);
    } else {
        client.global.clear("cartId");
    }
%}

### Add two units of Product A
POST {{baseUrl}}/carts/{{cartId}}/items
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "productId": "{{productAId}}",
  "quantity": 2
}

### Verify the cart item snapshot/input
GET {{baseUrl}}/carts/{{cartId}}
Authorization: Bearer {{accessToken}}
